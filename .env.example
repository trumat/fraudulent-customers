APP_NAME="Fraud Scanner"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug

DB_CONNECTION=sqlite

SESSION_DRIVER=database
CACHE_STORE=database
QUEUE_CONNECTION=sync

VITE_APP_NAME="${APP_NAME}"

CUSTOMERS_API_URL=http://host.docker.internal:8080/api/v1
CUSTOMERS_API_TIMEOUT=5
CUSTOMERS_API_ATTEMPTS=3
CUSTOMERS_API_RETRY_SLEEP_MS=300
